%section{class: "latest-reports", "aria-label": "Tournament Reports"}
  %header
    %h4= t("pages.reports.latest")
    =link_to articles_path({category: "tournament"}), class: "inline-glyph" do
      %span
        =t("all")
        %span.hidden-xs= t("pages.reports.reports")
      %span.glyphicon.glyphicon-chevron-right.glyphicon-xs
  %div.content-grid
    - @reports.each do |report|
      %div.each-report
        - if (image = report.thumbnail_image)
          %div.thumbnail-image{style: "background-image: url(#{image.data.url(image.style_for(300, 200))}); background-size: cover;"}
        - else
          %div.thumbnail-image
        =link_to report.title, article_path(report)
