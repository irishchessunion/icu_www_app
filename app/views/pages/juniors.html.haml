- content_for :title, t("junior.chess")
- content_for :header_bg_color, "var(--gray-lighter)"
- @show_main_container = "false"

= render "utils/title_panel", header_text: t("junior.chess")

.container
  .row
    .col-sm-3
      .panel.panel-pastel-primary
        %ul.list-group
          - unless @officer.nil?
            %li.list-group-item
              %strong Junior Officer:
              = @officer.player.name
          %li.list-group-item
            For any enquiries please email
            = mail_to "juniors@icu.ie"
      = render "home_page_links"
      = render "junior_events"
      = render 'junior_international_events'
    .col-sm-6
      .row
        .col-sm-6
          = render "junior_organisations"
        .col-sm-6
          = render "learner_docs"
      = render 'news'
    .col-sm-3
      = render "junior_ratings"
      = render "child_protection_policy"
      .voffset3
        = render 'junior_clubs'
      = render "champions/champion", champion: Champion.recent(:u19).first
      = render "champions/champion", champion: Champion.recent(:g19).first
      = render "champions/champion", champion: Champion.recent(:u16).first
      = render "champions/champion", champion: Champion.recent(:g16).first
      = render "champions/champion", champion: Champion.recent(:u14).first
      = render "champions/champion", champion: Champion.recent(:g14).first
      = render "champions/champion", champion: Champion.recent(:u12).first
      = render "champions/champion", champion: Champion.recent(:g12).first
      = render "champions/champion", champion: Champion.recent(:u10).first
      = render "champions/champion", champion: Champion.recent(:g10).first
      = render "champions/champion", champion: Champion.recent(:u8).first
      = render "champions/champion", champion: Champion.recent(:g8).first
      = render("disclaimer")
  .row
    .col-sm-12
      = render 'layouts/sponsors'
