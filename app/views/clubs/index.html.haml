- content_for :title, t("club.directory.title")
- content_for :header_bg_color, "var(--gray-lighter)"
- @show_main_container = "false"

.clubs-directory
  = render layout: "utils/title_panel", locals: { header_text: t("club.directory.title"), css: "no-margin" } do
    - if can?(:create, Club)
      = link_to t("club.directory.new"), new_admin_club_path, class: "btn btn-primary hidden-xs"

  = form_with url: clubs_path, method: :get, local: true do
    = render layout: "utils/sub_panel_bar" do
      = render "search_form"

    .container.voffset3
      = render "results"
