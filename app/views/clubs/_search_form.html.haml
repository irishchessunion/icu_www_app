.inline-flex.inline-between.flex-wrap.stack-xs
  .inline-flex.flex-wrap.stack-xs.form-inline
    .form-group.no-margin
      = label_tag :search, t("club.directory.search"), class: "sr-only"
      = search_field_tag :search, params[:search], class: "form-control", placeholder: t("club.directory.search")
    .form-group.no-margin
      = label_tag :county, t("club.county"), class: "sr-only"
      = select_tag :county, club_county_menu(params[:county]), class: "form-control"
    - if can?(:manage, Club)
      = render "utils/toggle_checkbox_field", name: "include_inactive", label: t("club.directory.include_inactive")
    = button_tag t("search"), type: "submit", class: "btn btn-info"
  .inline-flex.form-inline
    %geolocation.btn.btn-pastel-info{data: { action: "location->clubs-directory#located" }, "aria-label": t("club.directory.near_me")}
      = button_tag t("club.directory.near_me"), type: "button", class: "btn btn-pastel-info", data: { action: "clubs-directory#locate", clubs_directory_target: "locate" }
    .form-group.no-margin
      = label_tag :radius, t("club.directory.radius"), class: "sr-only"
      = select_tag :radius, options_for_select([10, 25, 50, 100, 150].map { |km| ["#{km}km", km] }, 10), class: "form-control", data: { clubs_directory_target: "radius" }
  %span.sr-only{role: "status", data: { clubs_directory_target: "locationStatus" }}
