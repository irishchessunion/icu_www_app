.inline-flex.inline-between.flex-wrap.stack-xs
  .inline-flex.flex-wrap.stack-xs.form-inline
    .form-group.no-margin
      = label_tag :search, t("club.directory.search"), class: "sr-only"
      = search_field_tag :search, params[:search], class: "form-control", placeholder: t("club.directory.search")
    .form-group.no-margin
      = label_tag :county, t("club.county"), class: "sr-only"
      = select_tag :county, club_county_menu(params[:county]), class: "form-control"
    - if @include_inactive
      = render "utils/toggle_checkbox_field", name: "include_inactive", label: t("club.directory.include_inactive")
    = button_tag t("search"), type: "submit", class: "btn btn-info"
