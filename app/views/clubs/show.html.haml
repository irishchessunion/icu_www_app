- content_for :title, t("club.club") + " | " + @club.name
- content_for :header_bg_color, "var(--gray-lighter)"
- @show_main_container = "false"
- content_for :includes do
  = javascript_include_tag "maplibre-gl"
  = stylesheet_link_tag "maplibre-gl", skip_pipeline: true
- content_for :javascript do
  = render(partial: "show", handlers: [:erb], formats: [:js])

= render "clubs/show_panel"
= render "clubs/show_nav"

.container
  .row
    .col-md-12.flex-row

      .primary-content
        = render "clubs/show_description"
        - if @entries.present? && can?(:show, @entries.matches.first)
          %button{type: "button", "data-toggle": "collapse", "data-target": "#changeLog", class: "btn btn-sm btn-pastel-primary"}
            View changelog
          %div{id: "changeLog", class: "collapse"}
            = render "admin/journal_entries/changes", entries: @entries

      %aside{class: "side-content"}
        = render "clubs/show_admin"
        = render "clubs/show_meetings"
        = render "clubs/show_contact"
        = render "clubs/show_players"

- if @club.geocodes?
  - popup_html = render(partial: "clubs/marker_popup", locals: { club: @club }, formats: [:html], handlers: [:haml])
  - markers = [{ "lat" => @club.lat, "lng" => @club.long, "title" => @club.name, "iconUrl" => asset_path("svg/marker_other.svg"), "popupHtml" => popup_html }]
  %script{type: "application/json", id: "map-data"}= raw json_escape(JSON.generate({ "center" => [@club.lat, @club.long], "zoom" => 13, "fit" => false, "markers" => markers }))
