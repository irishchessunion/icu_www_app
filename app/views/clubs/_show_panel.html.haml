%section{class: "full-width static-panel"}
  .container
    .row
      .col-md-12.flex-row
        .show-panel

          %div
            %a{href: clubs_path, class: "inline-glyph"}
              %span.glyphicon.glyphicon-chevron-left.glyphicon-xs
              = "#{t('all')} #{t('club.clubs')}"
          %h2= @club.name
          .subtitle
            - location_parts = @club.location_parts
            - location_parts.each_with_index do |part, index|
              %div= index < location_parts.length - 1 ? "#{part}," : part

          - if @club.web.present?
            %div.inline-flex.buttons
              = link_to @club.web, target: "club", class: "btn btn-pastel-info inline-glyph" do
                %span.glyphicon.glyphicon-link.glyphicon-sm
                = URI(@club.web).host
        - if @club.geocodes?
          %aside{class: "map", "aria-label": t("club.map")}
            %div{style: "width: 100%; aspect-ratio: 4/3; border-radius: 4px; background: #CCC; overflow: hidden"}
              #map-canvas{style: "width: 100%; height: 100%"}
