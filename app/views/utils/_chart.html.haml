%section.charts.full-width{
  class: local_assigns[:css],
  id: key,
  "aria-labelledby": "#{key}-title",
  data: {
    controller: "chart",
    chart_url_value: url,
    chart_title_value: title
  }
}

  %header.inline-between.flex-wrap
    %h4.no-margin{id: "#{key}-title"}
      = title
    .inline-flex{
      role: "group",
      "aria-label": "#{title} period",
      data: { chart_target: "period", action: "change->chart#load" }
    }
      %span Period:
      = render "utils/inline_radio_field",
        name: "#{key}_period",
        options: periods.map { |period| [period, period.humanize] },
        checked: periods.first,
        include_all: false
  .panel.panel-chart-filters{
    role: "group",
    "aria-label": "#{title} breakdown",
    data: { chart_target: "breakdown", action: "change->chart#refresh" }
  }
    .panel-body
      = render "utils/inline_radio_field",
        name: "#{key}_breakdown",
        options: breakdowns,
        checked: breakdowns.first.first,
        include_all: false

  %p.text-muted.voffset2{role: "status", data: { chart_target: "status" }}
    Loading chart...

  %div{
    role: "region",
    "aria-label": "#{title} chart",
    data: { chart_target: "chart" }
  }
