%section.row{"data-controller" => "club-meetings"}
  = form.label :meet, t("club.meet"), class: "control-label col-sm-1"
  .col-sm-10
    %button.btn.btn-pastel-info{type: "button", "data-action" => "club-meetings#add"}= t("club.meetings.add")
    %div.voffset1{"data-club-meetings-target" => "list"}
      = form.fields_for :club_meetings, ordered_club_meetings(@club.club_meetings) do |meeting_form|
        = render "admin/clubs/meeting_fields", meeting_form: meeting_form
    %template{"data-club-meetings-target" => "template"}
      = form.fields_for :club_meetings, ClubMeeting.new, child_index: "NEW_RECORD" do |meeting_form|
        = render "admin/clubs/meeting_fields", meeting_form: meeting_form
    - if @club.meet.present?
      .form-group.voffset2
        .col-sm-8
          = form.text_field :meet, class: "form-control", disabled: true
        .col-sm-8.voffset1
          .panel.panel-pastel-warning
            .panel-body
              Legacy field can no longer be edited. Instead add / edit meetings above.
