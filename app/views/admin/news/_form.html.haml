.row
  .col-sm-1
  .col-sm-10
    = form_for [:admin, @news], html: { class: "form-horizontal", role: "form" } do |f|
      %fieldset
        = render "utils/form_header", object: @news, atr: :headline
        - locals = { form: f, object: @news, col: "sm", pad: 2, mark: "required" }
        = render "utils/text_field_for", locals.merge(param: :headline, text: t("news.headline"), width: 7)
        - unless @news.new_record?
          = render "utils/text_field_for", locals.merge(param: :date, text: t("date_label"), width: 3)
        = render "utils/select_for", locals.merge(param: :selected_categories, text: t("categories"), menu: categories_menu(@news.selected_categories), multiple: true, width: 4, size: 12)
        = render "utils/check_box_for", locals.merge(param: :active, text: t("active"), width: 1, mark: "none")
        .form-group#news_image
          = f.label :image_id, t("news.image"), class: "control-label col-sm-2"
          .col-sm-7
            = f.hidden_field :image_id
            .inline-flex
              #news_image_preview
                - if @news.image
                  = image_tag @news.image.data.url(:thumbnail), alt: @news.image.caption
                - else
                  %span.text-muted= t("news.no_image")
              %button.btn.btn-default.btn-sm{type: "button", "data-toggle" => "modal", "data-target" => "#image_ids_modal"}= t("news.choose_image")
              %button.btn.btn-default.btn-sm#news_image_remove{type: "button", class: @news.image ? "" : "hidden"}= t("news.remove_image")
            .help-block= t("news.image_hint")
        .form-group{class: @news.errors[:summary].any? ? "has-error" : ""}
          .row
            .col-sm-12.text-center= f.label :summary, t("news.summary"), class: "control-label"
          .row
            .col-sm-12.voffset1
              .btn-toolbar.voffset1#wysiwyg_toolbar_extra
                %button.btn.btn-default.btn-sm{type: "button", "data-toggle" => "modal", "data-target" => "#article_ids_modal"} Link Article
                %button.btn.btn-default.btn-sm{type: "button", "data-toggle" => "modal", "data-target" => "#event_ids_modal"} Link Event
              = f.text_area :summary, id: "news_summary", value: @news.editor_html, class: "form-control insignificant-space wysiwyg-editor", rows: 10
      = render "utils/form_buttons", form: f, object: @news

= render "admin/wysiwyg_editor_extras", images: false
= render "admin/image_ids/modal", title: t("news.choose_image")
%script
  :plain
    // Replaces the editor's callback, which would insert an [IMG:id] token into the summary
    function image_ids_callback(id, caption, thumbnail) {
      $('#news_image_id').val(id);
      $('#news_image_preview').empty().append($('<img>', { src: thumbnail, alt: caption }));
      $('#news_image_remove').removeClass('hidden');
      $('#image_ids_modal').modal('hide');
    }
    $('#news_image_remove').on('click', function() {
      $('#news_image_id').val('');
      $('#news_image_preview').empty().append($('<span>', { class: 'text-muted', text: #{t("news.no_image").to_json} }));
      $(this).addClass('hidden');
    });
