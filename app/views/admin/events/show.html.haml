- content_for :title, @event.name
- content_for :header_bg_color, "var(--gray-lighter)"
- content_for :includes do
  = javascript_include_tag "apexcharts.min"
- @show_main_container = "false"

= render "utils/title_panel", header_text: @event.name, back_button: true, back_text: t("event.event").downcase, back_path: event_path(@event) do
  %div.inline-flex
    - if can?(:edit, @event)
      = link_to t("edit"), edit_admin_event_path(@event), class: "btn btn-primary"
    - if can?(:destroy, @event)
      = link_to t("delete"), admin_event_path(@event), data: { confirm: t("event.admin.confirm_delete") }, method: :delete, class: "btn btn-danger"

.container
  .row
    .col-md-8.col-sm-12
      - if @event.has_full_access?(current_user) || current_user.admin? || current_user.treasurer?
        = render "utils/chart",
          key: "event-entries",
          title: "Entries by",
          url: entries_chart_admin_event_path(@event),
          periods: %w[day week month],
          breakdowns: [["section", "Section"], ["fee", "Fee"], ["gross", "Gross"]]
        .row.voffset3
          .col-md-7.col-sm-12
            = render "admin/events/entry_fees_panel"
          .col-md-5.col-sm-12.voffset3-sm
            %section.charts#latest-entries
              %h4.no-margin Latest Entries
              .panel.panel-default
                .list-group
                  - @latest_entries.each do |entry|
                    .list-group-item.inline-between
                      %span
                        = entry.player&.name || entry.new_player&.name || "Unknown Player"
                      %small
                        = "#{time_ago_in_words(entry.cart&.payment_completed || entry.created_at).delete_prefix('about ')} ago"
                  - if can?(:index, Item)
                    .list-group-item.inline-between
                      = link_to admin_items_path(event_id: @event.id) do
                        All Entry Payments
                      %span.glyphicon.glyphicon-chevron-right.glyphicon-xs.text-success{"aria-hidden": "true"}

    %aside.col-md-4.col-sm-12.voffset3-sm
      - if @event.has_full_access?(current_user) || current_user.admin? || current_user.treasurer?
        .panel.panel-default
          .panel-heading
            %strong.stats-figure= euros(event_total_paid_fees(@event))
            %div= "From #{event_count_paid_fees(@event)} entries"

      - if @event.has_any_access?(current_user) || current_user.admin?
        = render "admin/events/users_panel"

      .panel.panel-default.with-margin
        .panel-heading
          = t("event.admin.sections")
        .panel-body
          %ul.panel-list.with-divider
            - @event.section_names.each do |section|
              %li.inline-between
                %span
                  = section.capitalize
                  %span.label.label-rounded.label-default.label-left-margin
                    = "#{@event.items.paid.where(section: section).size}"
                .btn-group
                  %button{type: "button", class: "btn btn-pastel-info btn-sm dropdown-toggle", "data-toggle" => "dropdown"}
                    Downloads
                    %span.caret
                  %ul{role: "menu", class: "dropdown-menu"}
                    %li= link_to "SwissManager (xlxs)", excel_list_event_path(@event.id, section: section)
                    %li= link_to "SwissPerfect (csv)", csv_list_event_path(@event.id, section: section)
                    %li= link_to "FIDE pre-2013", swiss_manager_event_path(@event.id, section: section)

      - if @entries.present? && (@event.owner?(current_user) || current_user.admin?)
        = render "admin/events/changelog", entries: @entries

- if @event.owner?(current_user) || current_user.admin?
  = render "admin/events/add_user_modal"
