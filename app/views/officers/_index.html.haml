%table{class: "table table-striped"}
  %thead
    %tr
      %th= t("officer.officer")
      %th= t("name")
      %th= t("email")
      %th= t("officer.phone")
  %tbody
    - officers.each do |officer|
      %tr
        %td
          = succeed(officer.executive ? "" : "*") do
            = officer.name
        %td= officer.player.name if officer.player
        %td= officer.html_email
        %td= officer.phone
%p.small.text-center
  = "*"
  = t("officer.non_exec")
  = t("officer.officer")
