!!!
%html
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1.0"}
    %meta{name:"chesstempo_path", content: "#{chesstempo_image_path}"}
    %title= content_for?(:title) ? yield(:title) : t("icu.icu")
    -# Test-only (the gem is in the :test group): lets Capybara wait for page loads and AJAX. Must come before other scripts.
    = capybara_lockstep if defined?(Capybara::Lockstep)
    = stylesheet_link_tag "#{current_user.preferred_theme.downcase}.min", media: "all"
    = stylesheet_link_tag "variables_#{current_user.preferred_theme.downcase}", media: "all"
    = stylesheet_link_tag "application", media: "all"
    = javascript_include_tag "application"
    - if Rails.env.test?
      -# Make Bootstrap's fades instant in specs, so modals and tabs open and close before Capybara's next step.
      = javascript_tag "$(function() { $.support.transition = false; });"
    -# Hotwire: stimulus/boot module + turbo module.
    -# two module scripts because turbo.js and stimulus.js declare conflicting top-level helpers
    = javascript_include_tag "turbo", type: "module"
    = javascript_include_tag "hotwire", type: "module", debug: false
    - if content_for?(:includes)
      = yield :includes
    - if content_for?(:javascript)
      = javascript_tag do
        = yield :javascript
    = csrf_meta_tags
  %body
    - if Rails.root.join("public", "system", "maintenance.html").exist?
      #maintenance Maintenance Mode
    = render "layouts/header_control"
    #header.jumbotron{style: "display: #{show_header?? 'block' : 'none'}"}
      .container= render "layouts/header"
    %header{ :style => (content_for(:header_bg_color) ? "background: #{yield(:header_bg_color)};" : 'background: var(--body-bg); margin-bottom: 21px') }
      .container
        = render "layouts/spacer"
        = render "layouts/nav"
        = render "layouts/spinner"
        = render "layouts/flash"
    %main{ :class => (defined?(@show_main_container) ? "" : "container") }
      = yield
    %footer.container
      = render "layouts/footer"
