- sections = local_assigns.fetch(:sections) { fee.section_names }
- selected = local_assigns.fetch(:selected) { params[:section] }
= render "fees/detail", term: "Event start", desc: fee.start_date.to_s
= render "fees/detail", term: "Event end", desc: fee.end_date.to_s
= render "fees/detail", term: "Name & ID", desc: player_name, id: "player_name"
- if sections.present?
  %p
    %em Section:
    = select_tag 'item[section]', options_for_select(sections, selected), class: "pull-right text-center"
